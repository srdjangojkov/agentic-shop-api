# Local development only. Copy to .env and fill in; never commit real values.
DB_URI=mongodb://127.0.0.1:27017/shop-api-dev
# Atlas: URL-encode special characters in the password. If you get
# "querySrv ECONNREFUSED", your DNS refuses SRV lookups; use Atlas's
# non-SRV (mongodb://host1,host2,host3/...) string instead.
# DB_URI=mongodb+srv://<user>:<password>@<cluster-host>/shop-api-dev
PORT=3002
SECRET_JWT=
SECRET_REFRESH_JWT=
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
